.intro,
.form-card {
  padding: 24rpx;
}

.intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff2b7;
}

.intro > image { flex-shrink: 0; }

.intro-title {
  font-size: 29rpx;
  font-weight: 900;
}

.intro-subtitle {
  margin-top: 9rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.form-title {
  margin: 34rpx 4rpx 16rpx;
  font-weight: 700;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  padding: 13rpx 20rpx;
  background: var(--paper);
  border: 4rpx solid var(--ink);
  font-size: 21rpx;
}

.choice.selected {
  color: #fff;
  background: var(--green);
}

.field {
  padding: 18rpx 0;
  border-bottom: 3rpx dashed #c9c0a5;
}

.field:last-child {
  border-bottom: 0;
}

.label {
  margin-bottom: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.input {
  height: 68rpx;
  padding: 0 15rpx;
  background: #f5eed8;
  border: 4rpx solid var(--ink);
  box-sizing: border-box;
}

.picker-value {
  line-height: 60rpx;
}

button.save-button {
  margin-top: 36rpx;
}
