.income-link {
  color: var(--green);
  font-size: 21rpx;
}

.income-list {
  padding: 6rpx 22rpx;
}

.income-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 3rpx dashed #c9c0a5;
}

.income-row:last-child {
  border-bottom: 0;
}

.income-name {
  font-size: 23rpx;
  font-weight: 700;
}

.income-meta {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.income-amount {
  color: var(--green);
  font-size: 24rpx;
  font-weight: 700;
}

button.income-delete {
  flex: 0 0 auto;
  width: auto;
  min-width: 88rpx;
  margin: 0 0 0 12rpx;
}
.income-row > view:first-child { flex: 1; min-width: 0; }
.income-amount { flex-shrink: 0; margin-left: 12rpx; }

.snapshot-card {
  padding: 22rpx;
}

.snapshot-chart {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 180rpx;
  border-bottom: 4rpx solid var(--ink);
}

.snapshot-column {
  position: relative;
  display: flex;
  align-items: flex-end;
  flex: 1;
  height: 100%;
}

.snapshot-bar {
  width: 100%;
  min-height: 10rpx;
  background: var(--green-soft);
  border: 3rpx solid var(--ink);
  border-bottom: 0;
}

.snapshot-date {
  position: absolute;
  left: 50%;
  bottom: -28rpx;
  font-size: 15rpx;
  transform: translateX(-50%);
}

.future-hero {
  position: relative;
  margin-top: 52rpx;
  padding: 32rpx;
  background: #cfe0b6;
}

.future-hero.portal-active {
  animation: portal-pulse 720ms steps(6, end);
}

.portal-pixel {
  position: absolute;
  color: var(--gold);
  font-size: 30rpx;
  text-shadow: 2rpx 2rpx 0 var(--ink);
  animation: portal-orbit 720ms steps(6, end) forwards;
}

.portal-1 { top: 18rpx; right: 34rpx; }
.portal-2 { top: 70rpx; right: 64rpx; }
.portal-3 { bottom: 22rpx; right: 28rpx; }

.future-kicker {
  color: var(--muted);
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.future-title {
  margin-top: 15rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.future-value {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 900;
}

.future-caption {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.scenario-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.scenario {
  padding: 18rpx 8rpx;
  text-align: center;
  font-size: 42rpx;
}

.scenario text {
  display: block;
  margin-top: 8rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.scenario:active {
  background: #fff2b7;
  transform: translate(4rpx, 4rpx);
  box-shadow: 3rpx 3rpx 0 rgba(45, 42, 36, .18);
}

.scenario.selected {
  background: #fff2b7;
  box-shadow: 7rpx 7rpx 0 var(--green);
  transform: translateY(-4rpx);
}

.route-message {
  margin-top: 18rpx;
  color: var(--green);
  font-size: 19rpx;
  line-height: 1.6;
}

.chart-scroll {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
}

.future-chart {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  width: max-content;
  height: 380rpx;
  padding: 44rpx 30rpx 70rpx;
  box-sizing: border-box;
}

.future-column {
  position: relative;
  display: flex;
  align-items: flex-end;
  width: 72rpx;
  height: 250rpx;
}

.future-bar {
  width: 100%;
  min-height: 14rpx;
  background: #8fb879;
  border: 4rpx solid var(--ink);
  transform-origin: bottom;
  animation: bar-grow 420ms steps(7, end) both;
}

@keyframes portal-pulse {
  0%, 100% { box-shadow: 8rpx 8rpx 0 rgba(45, 42, 36, 0.18); }
  50% { box-shadow: 10rpx 10rpx 0 var(--gold); transform: scale(1.015); }
}

@keyframes portal-orbit {
  from { opacity: 0; transform: rotate(0) translateX(0) scale(0); }
  to { opacity: 1; transform: rotate(180deg) translateX(28rpx) scale(1.1); }
}

@keyframes bar-grow {
  from { transform: scaleY(0); }
  to { transform: scaleY(1); }
}

.column-year {
  position: absolute;
  bottom: -46rpx;
  left: 50%;
  font-size: 21rpx;
  transform: translateX(-50%);
}

.column-value {
  position: absolute;
  z-index: 2;
  top: -30rpx;
  left: 50%;
  padding: 4rpx 7rpx;
  background: #fff2b7;
  border: 3rpx solid var(--ink);
  font-size: 16rpx;
  white-space: nowrap;
  transform: translateX(-50%);
}

.control-card {
  padding: 8rpx 24rpx 20rpx;
}

.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 3rpx dashed #c9c0a5;
}

.control-label {
  font-size: 23rpx;
  font-weight: 700;
}

.control-hint {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.control-input-wrap {
  display: flex;
  align-items: center;
  min-width: 160rpx;
  padding: 8rpx 10rpx;
  background: #f5eed8;
  border: 4rpx solid var(--ink);
  font-size: 21rpx;
}

.control-input-wrap input {
  flex: 1;
  min-width: 0;
  height: 40rpx;
  text-align: right;
}

.slider-block {
  padding-top: 22rpx;
}

.slider-label {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  font-weight: 700;
}

.disclaimer {
  padding: 24rpx 10rpx 0;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.6;
  text-align: center;
}
