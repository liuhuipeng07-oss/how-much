.weather-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 190rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.weather-card.weather-active {
  animation: weather-pulse 650ms steps(5, end);
}

.weather-hint {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 17rpx;
}

.weather-pixel {
  position: absolute;
  z-index: 3;
  color: var(--gold);
  text-shadow: 2rpx 2rpx 0 var(--ink);
  animation: weather-float 650ms steps(5, end) forwards;
}

.pixel-a { top: 18rpx; right: 36rpx; }
.pixel-b { top: 58rpx; right: 76rpx; }
.pixel-c { bottom: 24rpx; right: 28rpx; }

.weather-card.sunny { background: #fff0a8; }
.weather-card.rainy { background: #c7dbe2; }

.weather-icon {
  width: 130rpx;
  text-align: center;
  font-size: 86rpx;
}

.weather-copy {
  flex: 1;
  margin-left: 20rpx;
}

.weather-label {
  color: var(--muted);
  font-size: 20rpx;
}

.weather-title {
  margin-top: 8rpx;
  font-size: 31rpx;
  font-weight: 900;
}

.weather-text {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.change-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 26rpx;
}

.change-label {
  color: var(--muted);
  font-size: 21rpx;
}

.change-value {
  margin-top: 5rpx;
  font-size: 42rpx;
  font-weight: 900;
}

.rate-box {
  padding: 12rpx 16rpx;
  border: 4rpx solid var(--ink);
  font-size: 23rpx;
  font-weight: 700;
}

.rate-box.up { background: #cce2b2; }
.rate-box.down { background: #ebc0b5; }

.live {
  color: var(--red);
  font-size: 18rpx;
}

.mover-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.mover-row {
  display: flex;
  align-items: center;
  padding: 18rpx;
}

.mover-row.active {
  background: #fff2b7;
  animation: mover-pick 520ms steps(4, end);
}

.insight-card {
  margin-top: 22rpx;
  padding: 22rpx;
  color: var(--green);
  font-size: 21rpx;
  line-height: 1.6;
}

@keyframes weather-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); box-shadow: 8rpx 8rpx 0 var(--gold); }
}

@keyframes weather-float {
  from { opacity: 0; transform: translateY(20rpx) scale(0); }
  to { opacity: 1; transform: translateY(-20rpx) scale(1.2); }
}

@keyframes mover-pick {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(7rpx); }
}

.mover-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 4rpx solid var(--ink);
  font-size: 36rpx;
}

.mover-main {
  flex: 1;
  margin-left: 16rpx;
}

.mover-title {
  font-size: 24rpx;
  font-weight: 700;
}

.mover-sub {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.mover-change {
  font-size: 24rpx;
  font-weight: 700;
}

.log-card {
  padding: 24rpx;
}

.log-line {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 13rpx 0;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.log-dot {
  flex: 0 0 auto;
  width: 15rpx;
  height: 15rpx;
  margin-top: 8rpx;
  border: 3rpx solid var(--ink);
}

.log-dot.green { background: var(--green-soft); }
.log-dot.gold { background: var(--gold); }
.log-dot.blue { background: var(--blue); }
