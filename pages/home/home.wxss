.home-page { padding-top: 0; }
.home-safe-area { position: fixed; top: 0; left: 0; right: 0; background: #142125; z-index: 20; pointer-events: none; }
.home-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; padding-bottom: 24rpx; }
.brand { color: var(--gold); font-size: 48rpx; font-weight: 900; letter-spacing: 4rpx; }
.question { margin-top: 6rpx; color: var(--muted); font-size: 24rpx; }
.local-badge { padding: 8rpx 12rpx; border: 2rpx solid #536253; color: #c3cdb8; font-size: 19rpx; white-space: nowrap; }
.character-stage { overflow: hidden; }
.character-scene { position: relative; height: 420rpx; overflow: hidden; background: #7ba786; }
.landscape { position: absolute; width: 100%; height: 100%; }
.character-level, .character-energy { position: absolute; top: 18rpx; z-index: 2; display: flex; align-items: center; gap: 6rpx; padding: 10rpx 12rpx; color: #f5e8bb; background: #1c302de8; border: 3rpx solid #101c1d; font-size: 21rpx; }
.character-level { left: 18rpx; max-width: 70%; }
.character-energy { right: 18rpx; }
.character-bubble { position: absolute; z-index: 2; top: 84rpx; left: 50%; transform: translateX(-50%); max-width: 80%; padding: 10rpx 18rpx; border: 3rpx solid #3c3b29; color: #30362b; background: #fff4d8; font-size: 21rpx; text-align: center; }
.character-sprite { position: absolute; z-index: 1; width: 212rpx; height: 278rpx; left: 50%; bottom: 34rpx; transform: translateX(-50%); }
.character-sprite.active { animation: character-hop 400ms steps(3, end); }
.scene-vehicle { position: absolute; right: 30rpx; bottom: 36rpx; width: 168rpx; height: 120rpx; }
.scene-pet { position: absolute; left: 95rpx; bottom: 38rpx; width: 90rpx; height: 90rpx; }
.scene-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 8rpx; background: #172d2bc9; color: #fff3cc; font-size: 18rpx; text-align: center; }
.character-footer { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 22rpx 22rpx 14rpx; }
.character-identity { flex: 1; min-width: 0; }
.character-name { font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.character-meta { color: var(--muted); font-size: 20rpx; line-height: 1.6; margin-top: 6rpx; }
button.checkin-button { width: auto; flex: 0 0 190rpx; font-size: 22rpx; }
.equipment-scroll { width: 100%; }
.equipment-strip { display: flex; gap: 12rpx; padding: 10rpx 22rpx 22rpx; }
.equipment-slot { display: flex; flex: 0 0 126rpx; flex-direction: column; align-items: center; gap: 8rpx; padding: 12rpx 8rpx; border: 2rpx solid #53615b; background: #162426; min-width: 0; }
.equipment-slot text { width: 126rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; text-align: center; font-size: 19rpx; color: #d3d9c5; }
.equipment-slot:active { border-color: var(--gold); background: #354239; }
.equipment-empty { font-size: 22rpx; line-height: 1.6; color: var(--muted); }
.summary-card { margin-top: 24rpx; padding: 24rpx; }
.summary-heading { display: flex; align-items: center; justify-content: space-between; color: var(--gold); font-size: 27rpx; font-weight: 700; gap: 16rpx; }
button.privacy-toggle { width: auto; min-width: 76rpx; flex-basis: 76rpx; min-height: 64rpx; padding: 6rpx; box-shadow: none; font-size: 20rpx; }
.summary-total { font-family: 'Courier New', monospace; color: var(--gold); font-size: 57rpx; font-weight: 900; margin-top: 10rpx; line-height: 1.3; overflow-wrap: anywhere; }
.summary-change { margin-top: 10rpx; font-size: 24rpx; font-weight: 700; line-height: 1.6; }
.summary-caption { margin-top: 10rpx; color: var(--muted); font-size: 20rpx; line-height: 1.6; }
button.add-button { margin-top: 24rpx; }
.link { color: var(--gold); font-size: 22rpx; padding: 12rpx 0; }
.section-caption { color: var(--muted); font-size: 20rpx; }
.group-list { padding: 0 24rpx; }
.group-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 0; border-bottom: 2rpx solid #3b4948; }
.group-row:last-child { border-bottom: 0; }
.group-icon { flex-shrink: 0; }
.group-main { flex: 1; min-width: 0; }
.group-name { font-size: 26rpx; line-height: 1.5; }
.group-count { color: var(--muted); margin-top: 4rpx; font-size: 20rpx; }
.group-value { font-size: 25rpx; font-weight: 700; text-align: right; max-width: 45%; overflow-wrap: anywhere; }
.allocation-track { height: 8rpx; background: #142023; margin-top: 10rpx; }
.allocation-track view { height: 100%; }
.quick-actions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-top: 24rpx; }
button.quick-action { flex-direction: column; min-height: 122rpx; padding: 16rpx 6rpx; font-size: 23rpx; }
.stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.stat-card { padding: 24rpx 18rpx; }
.stat-label { color: var(--muted); font-size: 22rpx; }
.stat-value { margin-top: 12rpx; font-size: 30rpx; font-weight: 700; overflow-wrap: anywhere; }
button.share-button { margin-top: 28rpx; }
.coin-burst { position: absolute; z-index: 4; left: 46%; top: 40%; pointer-events: none; animation: coin-pop 620ms steps(5, end) forwards; }
@keyframes character-hop { 50% { transform: translateX(-50%) translateY(-16rpx); } }
@keyframes coin-pop { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-100rpx); } }
